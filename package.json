{
  "name": "protocol-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Science-backed AI protocol builder — Next.js web app + FastAPI engine.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,engine -c cyan,green \"npm run dev:web\" \"npm run dev:engine\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:engine": "cd services/engine && ../../.venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "test:engine": "cd services/engine && ../../.venv/bin/python -m pytest"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
